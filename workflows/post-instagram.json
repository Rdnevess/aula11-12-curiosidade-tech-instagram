      ],
      "parameters": {
        "method": "GET",
        "url": "https://graph.instagram.com/me",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "options": {},
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "user_id,username"
            }
          ]
        }
      },
      "credentials": {
        "httpQueryAuth": {
          "id": "OhUx4faLk6mOALHc",
          "name": "Instagram TEP"
        }
      }
    },
    {
      "id": "2e567d61-865c-5f60-9785-d9a36cff03e4",
      "name": "Criar contêiner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.instagram.com/{{ $json.user_id }}/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "options": {},
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify($('Preparar mídia').item.json.tipo === 'video' ? { media_type: 'REELS', video_url: $('Link direto').item.json.pagina.match(/https:\\/\\/tmpfiles\\.org\\/dl\\/[^\"]+/)[0], caption: $('Preparar mídia').item.json.legenda } : { image_url: $('Link direto').item.json.pagina.match(/https:\\/\\/tmpfiles\\.org\\/dl\\/[^\"]+/)[0], caption: $('Preparar mídia').item.json.legenda }) }}"
      },
      "credentials": {
        "httpQueryAuth": {
          "id": "OhUx4faLk6mOALHc",
          "name": "Instagram TEP"
        }
      }
    },
    {
