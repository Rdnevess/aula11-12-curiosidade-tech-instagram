{
  "name": "Aula 11 - Post no Instagram",
  "nodes": [
    {
      "id": "988473b0-a201-5313-8aae-6b08c35d968b",
      "name": "Novo post",
      "webhookId": "5b2d7c10-4e1a-4f6b-8c3d-1a0c11000001",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        0,
        0
      ],
      "parameters": {
        "formTitle": "Publicar no Instagram",
        "formDescription": "Escolha uma imagem JPEG ou um vídeo MP4/MOV do computador e escreva a legenda. Imagem vira post; vídeo vira Reel. O post sai na conta conectada ao app.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Mídia",
              "fieldName": "midia",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".jpg,.jpeg,.mp4,.mov",
              "requiredField": true
            },
            {
              "fieldLabel": "Legenda",
              "fieldName": "legenda",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {
          "path": "post-instagram"
        }
      }
    },
    {
      "id": "2423f19d-0ed4-5e1a-92c2-22ed02bb092b",
      "name": "Preparar mídia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// O formulário entrega o arquivo com o rótulo do campo como chave do binário.\n// Aqui ele passa a se chamar \"midia\"; o tipo (imagem ou vídeo) e a legenda vão para o JSON.\nconst TIPOS = { 'image/jpeg': 'imagem', 'video/mp4': 'video', 'video/quicktime': 'video' };\nconst item = $input.first();\nconst chave = Object.keys(item.binary ?? {})[0];\nif (!chave) throw new Error('Nenhum arquivo recebido do formulário.');\nconst arquivo = item.binary[chave];\nconst tipo = TIPOS[arquivo.mimeType];\nif (!tipo) throw new Error(`O Instagram aceita JPEG, MP4 ou MOV; o arquivo é ${arquivo.mimeType}.`);\nconst legenda = item.json.legenda ?? item.json.Legenda ?? '';\nreturn [{ json: { arquivo: arquivo.fileName, tipo, legenda }, binary: { midia: arquivo } }];\n"
      }
    },
    {
      "id": "808d51a9-9583-5637-91fb-8fd8c1de606b",
      "name": "Hospedar mídia",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://tmpfiles.org/api/v1/upload",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "midia"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "2d3d5bc6-29e9-56b2-ba7c-9b20d85921aa",
      "name": "Link direto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "url": "={{ $json.data.url.replace('http://', 'https://') }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "pagina"
            }
          }
        }
      }
    },
    {
      "id": "f125b630-fde7-5284-beab-d3700687d6e7",
      "name": "Conta do Instagram",
